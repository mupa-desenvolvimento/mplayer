<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext permitido: o TCServer Mupa roda em HTTP na rede local da loja e o
         IP é configurável por cliente. As APIs de nuvem (Zaffari, Komprão) continuam
         em HTTPS normalmente — permitir cleartext não as rebaixa. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
