<?xml version="1.0" encoding="utf-8"?>
<!-- Variante HORIZONTAL: painel de métricas fica na LATERAL DIREITA (no vertical vai pro bottom,
     ver res/layout/activity_face_recognition_test.xml). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/enterprise_bg">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Face Overlay -->
    <com.mupa.player.enterprise.ui.FaceOverlayView
        android:id="@+id/faceOverlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Warning Banner (LGPD) -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txtTransparencyWarning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:padding="10dp"
        android:text="Este terminal coleta dados estatísticos anônimos para melhoria de serviços, sem retenção de imagens ou dados pessoais."
        android:textColor="@color/enterprise_on"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardResults" />

    <!-- Header / Close button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:backgroundTint="#AA000000"
        app:icon="@android:drawable/ic_menu_revert"
        app:iconTint="@color/enterprise_on"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTransparencyWarning" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:background="#AA000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Teste de Reconhecimento Facial"
        android:textColor="@color/enterprise_on"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- Painel de métricas na LATERAL DIREITA. Altura = wrap_content pra encolher quando
         recolhido (só o cabeçalho + botão ficam visíveis). -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResults"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#CC111827"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/mupa_cyan"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Cabeçalho do painel: título + botão expandir/ocultar. -->
            <LinearLayout
                android:id="@+id/metricsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Métricas de Detecção"
                    android:textColor="@color/mupa_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleMetrics"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:icon="@android:drawable/arrow_down_float"
                    app:iconTint="@color/mupa_cyan" />
            </LinearLayout>

            <!-- Conteúdo recolhível: começa oculto (visibility=gone). -->
            <ScrollView
                android:id="@+id/metricsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:paddingTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtCameraStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status da câmera: Inicializando..."
                        android:textColor="@color/enterprise_on_muted"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtModelStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modelos:\n- Verificando..."
                        android:textColor="@color/enterprise_on"
                        android:textSize="12sp"
                        android:typeface="monospace"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadModels"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Baixar Modelos Facial"
                        android:textColor="@color/enterprise_on"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtDetectionDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nenhum rosto detectado no frame."
                        android:textColor="@color/enterprise_on"
                        android:textSize="12sp"
                        android:typeface="monospace" />

                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
