<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/enterprise_bg"
    android:padding="24dp">

    <!-- Header Section -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/settingsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Preferências e Configurações"
        android:textColor="@color/enterprise_on"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:backgroundTint="@color/enterprise_surface"
        app:icon="@android:drawable/ic_menu_close_clear_cancel"
        app:iconTint="@color/enterprise_on"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Card 1: Device Information -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/enterprise_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#222C3D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informações do Dispositivo"
                        android:textColor="@color/mupa_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtDeviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome: -"
                        android:textColor="@color/enterprise_on"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtDeviceId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Serial/ID: -"
                        android:textColor="@color/enterprise_on"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtPlaylistName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Playlist Ativa: -"
                        android:textColor="@color/enterprise_on"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtCompanyTenant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Empresa/Tenant: -"
                        android:textColor="@color/enterprise_on"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtApiEndpoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="API de Consulta: -"
                        android:textColor="@color/enterprise_on_muted"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Filial / Loja -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/enterprise_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#222C3D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alterar Filial (Loja)"
                        android:textColor="@color/mupa_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutFilial"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Número da Filial"
                            app:hintTextColor="@color/mupa_cyan"
                            app:boxStrokeColor="@color/mupa_cyan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editFilial"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/enterprise_on" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveFilial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:text="Salvar"
                            android:backgroundTint="@color/mupa_cyan"
                            android:textColor="@color/enterprise_bg" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Heartbeat Inteligente -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/enterprise_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#222C3D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heartbeat Inteligente"
                        android:textColor="@color/mupa_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minutos de ociosidade (sem nenhuma consulta) antes de enviar um heartbeat. Faixa: 30–120."
                        android:textColor="@color/enterprise_on"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutHeartbeatIdleMinutes"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Minutos (30-120)"
                            app:hintTextColor="@color/mupa_cyan"
                            app:boxStrokeColor="@color/mupa_cyan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editHeartbeatIdleMinutes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/enterprise_on" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveHeartbeatIdleMinutes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:text="Salvar"
                            android:backgroundTint="@color/mupa_cyan"
                            android:textColor="@color/enterprise_bg" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: TCServer Gertec -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/enterprise_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#222C3D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TCServer Mupa (Consulta Preço via LAN)"
                        android:textColor="@color/mupa_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quando preenchido, a consulta de preço usa o TCServer da loja em vez das APIs. Deixe vazio para desativar."
                        android:textColor="#9CA3AF"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchTcServerGertec"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Servidor Gertec (protocolo /barcode)"
                        android:textColor="@color/enterprise_on" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ligado: TCServer da Gertec (GET /barcode?param=, porta padrão 7476). Desligado: TCServer da Mupa (GET /consulta, JSON)."
                        android:textColor="#9CA3AF"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchTcServerGertecTcp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Protocolo TCP (socket, porta 6500)"
                        android:textColor="@color/enterprise_on" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Só com 'Servidor Gertec' ligado. Ligado: protocolo TCP nativo do terminal (#handshake, #ean → #descrição|preço, porta padrão 6500) — use com o serviço da Consinco. Desligado: HTTP."
                        android:textColor="#9CA3AF"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutTcServer"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="IP:Porta (ex: 192.168.0.10:8080)"
                            app:hintTextColor="@color/mupa_cyan"
                            app:boxStrokeColor="@color/mupa_cyan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTcServer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textColor="@color/enterprise_on" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveTcServer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:text="Salvar"
                            android:backgroundTint="@color/mupa_cyan"
                            android:textColor="@color/enterprise_bg" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestTcServer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Testar Conexão"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/mupa_cyan"
                        app:strokeColor="@color/mupa_cyan" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchGertecScanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Leitor integrado Gertec (SK100)"
                        android:textColor="@color/enterprise_on" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ativa o leitor de código de barras via SDK EasyLayer. Usar apenas em terminais Gertec SK."
                        android:textColor="#9CA3AF"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Switches Modo Dev & Manutenção -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/enterprise_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#222C3D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDevMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Habilitar Modo Desenvolvedor (Dev)"
                        android:textColor="@color/enterprise_on"
                        android:textSize="15sp"
                        app:thumbTint="@color/mupa_cyan"
                        app:trackTint="@color/mupa_cyan_dark"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDemoMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Habilitar Modo de Demonstração (Demo)"
                        android:textColor="@color/enterprise_on"
                        android:textSize="15sp"
                        app:thumbTint="@color/mupa_cyan"
                        app:trackTint="@color/mupa_cyan_dark"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMaintenanceMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Habilitar Tela de Manutenção / Simulador"
                        android:textColor="@color/enterprise_on"
                        android:textSize="15sp"
                        app:thumbTint="@color/mupa_cyan"
                        app:trackTint="@color/mupa_cyan_dark"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestFaceRecognition"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Testar Reconhecimento Facial"
                        android:textColor="@color/enterprise_on"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Simulador de Código de Barras (Manutenção) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMaintenance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/enterprise_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#222C3D"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simulador de Consulta (Manutenção)"
                        android:textColor="@color/mupa_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutSimulate"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Digitar Código de Barras (EAN)"
                            app:hintTextColor="@color/mupa_cyan"
                            app:boxStrokeColor="@color/mupa_cyan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editSimulateBarcode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:textColor="@color/enterprise_on" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimulateQuery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:text="Simular"
                            android:backgroundTint="@color/mupa_cyan"
                            android:textColor="@color/enterprise_bg" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Ações do Manifesto e Sincronização -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/enterprise_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#222C3D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gerenciamento do Manifesto"
                        android:textColor="@color/mupa_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewManifest"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Exibir Manifesto Local"
                        android:textColor="@color/enterprise_on"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadManifest"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Baixar Novo Manifesto"
                        android:textColor="@color/enterprise_on"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncTest"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Executar Teste de Sincronização"
                        android:textColor="@color/enterprise_on"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadDetections"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enviar Detecções para o Supabase"
                        android:textColor="@color/enterprise_on" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadPriceQueries"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enviar Consultas de Preços para o Supabase"
                        android:textColor="@color/enterprise_on"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadMissingImages"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enviar Imagens Ausentes para o Supabase"
                        android:textColor="@color/enterprise_on"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtSyncProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/mupa_cyan"
                        android:textSize="13sp"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 6: Reset / Limpeza -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/enterprise_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#5c1d1d">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zona de Perigo"
                        android:textColor="#FF5252"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Redefinir as configurações reverterá o terminal para o estado de fábrica inicial. Isso limpa todos os dados locais."
                        android:textColor="@color/enterprise_on_muted"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloseApp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Fechar Aplicativo"
                        android:backgroundTint="#374151"
                        android:textColor="@color/enterprise_on" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetApp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Resetar / Limpar Aplicativo"
                        android:backgroundTint="#D32F2F"
