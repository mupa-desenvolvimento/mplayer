<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:paddingTop="10dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/slotLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="2dp"
        android:textSize="13sp"
        android:textColor="#B3FFFFFF"
        android:textStyle="normal"
        android:letterSpacing="0.04"
        android:maxLines="2"
        android:ellipsize="end" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/slotFromPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="4dp"
        android:textSize="14sp"
        android:textColor="#B3FFFFFF"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/slotPriceBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="120dp"
        android:background="@drawable/bg_price_slot_box"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:gravity="bottom">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/slotCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="6dp"
                android:layout_marginEnd="3dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/slotIntegerPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="46sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:includeFontPadding="false" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/slotDecimalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=",00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="8dp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
