<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/priceResultRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/priceLandscapeSplitGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/priceLeftPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="#111827"
        android:padding="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/priceLandscapeSplitGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/priceNameBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/priceNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="PRODUTO"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:layout_marginBottom="-20dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/priceNameSecondLineText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text=""
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:visibility="gone"
                    android:layout_marginBottom="-5dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/priceSubtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:includeFontPadding="false"
                    android:text="SUBTITULO"
                    android:textColor="#E6FFFFFF"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/priceSmartCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/priceBadgesRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/price_section_spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/priceNameBar">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/priceLeftBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="LEVE 3"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/priceRightBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="PAGUE 2"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/priceOfflineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="OFFLINE"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Varejo e Atacado Estático -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/price_section_spacing_lg"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/priceBadgesRow">

            <!-- Seção Varejo -->
            <LinearLayout
                android:id="@+id/varejoSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/priceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Varejo:"
                    android:textColor="#9CA3AF"
                    android:textSize="14sp"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_price_slot_box"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/priceCurrency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#6B7280"
                            android:layout_marginBottom="3dp"
                            android:layout_marginEnd="2dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/priceInteger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#6B7280"
                            android:includeFontPadding="false" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/priceDecimal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=",00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#6B7280"
                            android:layout_marginBottom="5dp"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Seção Atacado -->
            <LinearLayout
                android:id="@+id/atacadoSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/priceWholesaleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atacado:"
                    android:textColor="#ef4444"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_price_slot_box"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/priceWholesaleCurrency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#ef4444"
                            android:layout_marginBottom="6dp"
                            android:layout_marginEnd="4dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/priceWholesaleInteger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="64sp"
                            android:textStyle="bold"
                            android:textColor="#ef4444"
                            android:includeFontPadding="false" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/priceWholesaleDecimal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=",00"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="#ef4444"
                            android:layout_marginBottom="16dp"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/priceCodeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:includeFontPadding="false"
            android:text="Código:"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/priceRightPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/priceLandscapeSplitGuide"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/priceProductGlowEffect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/priceProductImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mplayer" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
